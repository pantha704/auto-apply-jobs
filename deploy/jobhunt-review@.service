[Unit]
Description=Job hunt reviewer worker %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/job_hunt_linkedin
EnvironmentFile=-/etc/jobhunt/job-hunt.env
Environment=TMPDIR=/home/ubuntu/tmp_chrome
ExecStartPre=/bin/bash /home/ubuntu/job_hunt_linkedin/reset_claims.sh rev-%i wellfound
ExecStart=/home/ubuntu/jobhunt-venv/bin/python /home/ubuntu/job_hunt_linkedin/worker_review.py rev-%i
Restart=always
RestartSec=20
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/job_hunt_linkedin /home/ubuntu/tmp_chrome

[Install]
WantedBy=multi-user.target
